# Quartus Prime settings for the AES-128 FPGA design.
# Board: Terasic DE10-Lite (Intel MAX 10, 10M50DAF484C7G, 50 MHz clock).
# Pin numbers: double-check against the DE10-Lite User Manual before programming.

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY de10_lite_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name VERILOG_INPUT_VERSION VERILOG_2001

# ---------------- Source files ----------------
set_global_assignment -name VERILOG_FILE ../rtl/common/aes_key_expansion.v
set_global_assignment -name VERILOG_FILE ../rtl/decryption/aes_decrypt.v
set_global_assignment -name VERILOG_FILE ../rtl/decryption/aes_decrypt_controller.v
set_global_assignment -name VERILOG_FILE ../rtl/decryption/aes_inv_sbox.v
set_global_assignment -name VERILOG_FILE ../rtl/decryption/inv_add_round_key.v
set_global_assignment -name VERILOG_FILE ../rtl/decryption/inv_mix_columns.v
set_global_assignment -name VERILOG_FILE ../rtl/decryption/inv_shift_rows.v
set_global_assignment -name VERILOG_FILE ../rtl/decryption/inv_sub_bytes.v
set_global_assignment -name VERILOG_FILE ../rtl/encryption/add_round_key.v
set_global_assignment -name VERILOG_FILE ../rtl/encryption/aes_encrypt.v
set_global_assignment -name VERILOG_FILE ../rtl/encryption/aes_sbox.v
set_global_assignment -name VERILOG_FILE ../rtl/encryption/mix_columns.v
set_global_assignment -name VERILOG_FILE ../rtl/encryption/shift_rows.v
set_global_assignment -name VERILOG_FILE ../rtl/encryption/sub_bytes.v
set_global_assignment -name VERILOG_FILE ../rtl/top/aes_top.v
set_global_assignment -name VERILOG_FILE ../rtl/top/de10_lite_top.v
set_global_assignment -name VERILOG_FILE ../rtl/uart/baud_generator.v
set_global_assignment -name VERILOG_FILE ../rtl/uart/uart_interface.v
set_global_assignment -name VERILOG_FILE ../rtl/uart/uart_packet_parser.v
set_global_assignment -name VERILOG_FILE ../rtl/uart/uart_packet_sender.v
set_global_assignment -name VERILOG_FILE ../rtl/uart/uart_rx.v
set_global_assignment -name VERILOG_FILE ../rtl/uart/uart_tx.v
set_global_assignment -name SDC_FILE ../constraints/de10_lite.sdc

# ---------------- Pins ----------------
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_location_assignment PIN_B8  -to KEY[0]
set_location_assignment PIN_A7  -to KEY[1]
set_location_assignment PIN_A8  -to LEDR[0]
set_location_assignment PIN_A9  -to LEDR[1]
set_location_assignment PIN_A10 -to LEDR[2]
set_location_assignment PIN_B10 -to LEDR[3]
set_location_assignment PIN_D13 -to LEDR[4]
set_location_assignment PIN_C13 -to LEDR[5]
set_location_assignment PIN_E14 -to LEDR[6]
set_location_assignment PIN_D14 -to LEDR[7]
set_location_assignment PIN_A11 -to LEDR[8]
set_location_assignment PIN_B11 -to LEDR[9]
set_location_assignment PIN_V10 -to UART_RXD
set_location_assignment PIN_W10 -to UART_TXD
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_RXD
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TXD
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to UART_RXD
